{
  "name": "cookbook-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "ios:reinstall": "expo run:ios --no-build-cache",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:i18n": "vitest run scripts/check-i18n-parity.test.ts",
    "generate:api": "openapi-typescript ../SharedCookbook/src/Web/wwwroot/api/specification.json -o services/api/generated/schema.d.ts && prettier --write services/api/generated/schema.d.ts",
    "deploy:ios:prod": "bash .cursor/skills/apple-upload/scripts/deploy.sh",
    "deploy:android:prod": "bash .cursor/skills/android-upload/scripts/deploy.sh"
  },
  "dependencies": {
    "@expo-google-fonts/playpen-sans": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.14",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-sync-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "date-fns": "^4.1.0",
    "expo": "^57.0.17",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.23",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.24",
    "expo-dev-client": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
